    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@jest/globals": "30.5.2",
    "eslint": "10.14.0",
    "globals": "17.13.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2"
  }
}
