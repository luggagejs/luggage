{
  "name": "@luggage/luggage-session",
  "version": "3.0.0",
  "description": "Dropbox authentication (OAuth 2 PKCE flow) for luggage apps",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "main": "./src/index.js",
  "files": [
    "src",
    "!src/**/__test__"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "lint": "eslint ."
  },
  "keywords": [
    "luggage",
    "dropbox"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "author": "dra1n <dra1n86@gmail.com> (https://github.com/dra1n)",
  "contributors": [
    {
      "name": "dra1n",
