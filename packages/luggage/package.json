{
  "name": "@luggage/core",
  "version": "3.0.0",
  "description": "Dropbox and Google Drive file API wrapper for storing json data.",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./dropbox": "./src/backends/dropbox/index.js",
    "./google-drive": "./src/backends/google-drive/index.js",
    "./dummy": "./src/backends/DummyBackend.js",
    "./package.json": "./package.json"
  },
  "main": "./src/index.js",
  "files": [
    "src",
    "!src/**/__test__"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "lint": "eslint ."
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "author": "dra1n",
  "license": "MIT",
  "peerDependencies": {
    "dropbox": "^10.0.0"
  },
  "peerDependenciesMeta": {
    "dropbox": {
      "optional": true
    }
  },
  "devDependencies": {
    "dropbox": "10.47.0"
  }
}
